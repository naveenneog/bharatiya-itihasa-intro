node_modules/
dist/
qa/
.tmp/
tmp/
*.log

# Sora reference frames are a deterministic ffmpeg crop of the still beside them —
# regenerable, so they stay out. The stills and clips themselves are committed:
# generative output cannot be reproduced, and every version is meant to be kept.
versions/**/clips/*-ref.png

# Layer plates are Playwright captures of the committed page, re-taken on every
# master render. The page is the source of truth, not the capture.
versions/**/build*/plates/

# Written by tools/publish.mjs on every run to compose the thumbnail in a page.
episodes/**/.thumb.html

# Thumbnail candidate pages are regenerated by tools/thumbnail.mjs on every run.
dist/thumbs-*/.*.html
